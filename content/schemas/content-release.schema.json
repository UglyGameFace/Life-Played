{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:life-played:schema:content-release:v1",
  "title": "Life Played Content Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "releaseVersion",
    "minimumClientVersion",
    "publishedAt",
    "fileHashes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "releaseVersion": {
      "type": "string",
      "minLength": 1
    },
    "minimumClientVersion": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "fileHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    }
  }
}
